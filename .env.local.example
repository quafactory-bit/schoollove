NEXT_PUBLIC_SUPABASE_URL=https://ucnybhzpbatzcipwqtox.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_SITE_URL=https://schoollove.kr
ADMIN_PASSWORD=your_admin_password_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
CRON_SECRET=generate_a_random_value_of_at_least_16_characters

# v2-09a Web Push(pwa-phase2 재사용). 공개키는 브라우저 구독용으로 번들에 들어가고,
# 개인키는 서버에만 둔다. 실제 값은 저장소에 넣지 않는다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your_contact@example.com

# PHASE 9 — 공개 프로필 등록(app/submit) CAPTCHA(Cloudflare Turnstile).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY: 공개 키, client 위젯에서 사용. 값이 없으면 등록 폼이
#   막히고 명확한 오류를 보여준다(등록 자체를 조용히 허용하지 않음).
# TURNSTILE_SECRET_KEY: 비밀 키, 서버(app/api/profiles/route.ts)에서만 사용. production에서
#   값이 없으면 등록 API가 fail-closed(500)로 차단된다. Cloudflare 공식 테스트 키
#   (https://developers.cloudflare.com/turnstile/troubleshooting/testing/)는 로컬 개발
#   전용이며 production에서는 절대 사용하지 않는다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
